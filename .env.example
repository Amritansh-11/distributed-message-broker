# Distributed Message Broker — Environment Variables Example
BROKER_ID=broker-1
BROKER_HOST=127.0.0.1
BROKER_PORT=5000
HTTP_PORT=8000
BROKER_DATA_DIR=./data/broker-1
CLUSTER_BROKERS=broker-1:127.0.0.1:5000,broker-2:127.0.0.1:5001,broker-3:127.0.0.1:5002
REPLICATION_FACTOR=3
HEARTBEAT_INTERVAL=1000
ELECTION_TIMEOUT=2000
LOG_LEVEL=INFO
